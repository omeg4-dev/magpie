[Unit]
# Builds the window once at login and then waits, hidden. Super+V after this
# is a message to a process that is already running with the store open and
# GTK started — the difference between appearing and launching.
Description=Keep the magpie window warm
PartOf=default.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/magpie view --hidden
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
